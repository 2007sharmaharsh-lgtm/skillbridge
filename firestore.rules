rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if request is by the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to get user profile data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role check helpers
    function isRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // 2. Students collection
    match /students/{userId} {
      // Students can only write their own profile; Recruiters and Institution Admins can read
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 3. Recruiters collection
    match /recruiters/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 4. Institutions collection
    match /institutions/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 5. Opportunities collection
    match /opportunities/{oppId} {
      // Everyone authenticated can view opportunities
      allow read: if isAuthenticated();
      // Only recruiters can create/update their own opportunities
      allow create: if isAuthenticated() && request.resource.data.recruiterId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.recruiterId == request.auth.uid;
    }

    // 6. Applications collection
    match /applications/{appId} {
      // Students can view their own; Recruiters can view applications for their posted jobs
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || 
        resource.data.recruiterId == request.auth.uid ||
        getUserData().role == 'institution_admin'
      );
      // Students can submit application for themselves
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      // Recruiters can update application status for their opportunities
      allow update: if isAuthenticated() && resource.data.recruiterId == request.auth.uid;
      allow delete: if false;
    }

    // 7. Saved Opportunities
    match /savedOpportunities/{saveId} {
      allow read, write: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
    }
  }
}
